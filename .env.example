# CampusFind local development configuration.
# The URL and publishable key are public client configuration, not secrets.
# Never commit .env or expose a service-role/secret key.

VITE_SUPABASE_URL=https://upkyaupivigspwwunqpg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=upkyaupivigspwwunqpg

# Server-side runtime values for the same project
SUPABASE_URL=https://upkyaupivigspwwunqpg.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-public-supabase-publishable-key
SUPABASE_PROJECT_ID=upkyaupivigspwwunqpg

# Required only for server operations that use the admin client.
# Obtain this from Supabase Project Settings; never put it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct PostgreSQL connection string for Drizzle migrations
DATABASE_URL=

# Optional scheduled-job secret, only if cron endpoints are deployed
CAMPUSFIND_CRON_SECRET=
CAMPUSFIND_CRON_SECRET_PREVIOUS=

# Optional Google Analytics 4 measurement ID (for example G-XXXXXXXXXX).
# Leave blank until a property is created and consent/notice requirements are reviewed.
VITE_GA_MEASUREMENT_ID=

# Optional Google Search Console HTML verification token; never invent a token.
VITE_GOOGLE_SITE_VERIFICATION=
