# Local development configuration. Copy this file to .env and fill values locally.
# Use credentials for the same Supabase-compatible backend in browser and server.
# Never commit .env or expose the service-role key.

# Browser-safe values (publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server runtime values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional identifier for your own backend project
SUPABASE_PROJECT_ID=
