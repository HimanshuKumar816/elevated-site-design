# Copy into a local .env file and fill values from the connected Lovable Cloud project.
# Never commit the real .env file or paste its values into chat.

# Lovable Cloud / Supabase endpoint for browser requests
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side endpoint and matching keys for the same backend
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Project identifiers supplied by the Lovable/Supabase integration
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=
